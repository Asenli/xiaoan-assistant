# LLM Provider: openai | tongyi | deepseek | zhipu
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=

# 通义千问
DASHSCOPE_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./storage/xiaoan.db
CHROMA_PATH=./storage/chroma
DOCUMENT_PATH=./storage/documents

# Security
JWT_SECRET=change-this-to-a-strong-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
WIDGET_API_KEY=xiaoan-widget-key-change-in-production

# RAG Config
CHUNK_SIZE=512
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=6
RETRIEVAL_SCORE_THRESHOLD=0.35
RERANK_ENABLED=false
HYBRID_SEARCH_ENABLED=true
BM25_WEIGHT=0.3
VECTOR_WEIGHT=0.7
